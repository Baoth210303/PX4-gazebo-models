    <!-- Tennis Ball 5 (288 deg) -->
    <model name="tennis_ball_5">
      <pose relative_to="base_link">0.0176 -0.0542 -0.12 0 0 0</pose>
      <link name='ball_5_link'>
        <inertial>
          <mass>0.057</mass>
