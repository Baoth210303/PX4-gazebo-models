    <!-- UWB tag -->
    <include>
      <uri>model://uwb</uri>
      <name>uwb_tag</name>
      <pose>0 0 0.12 0 0 0</pose>
      <plugin name="uwb_plugin::UwbRange" filename="libuwb_range.so">
        <variance>0.05</variance>
      </plugin>
    </include>

    <joint name="uwb_joint" type="fixed">
      <parent>base_link</parent>
      <child>uwb_tag::link</child>
    </joint>

    <!-- Detachable Joint Plugins for Tennis Balls -->
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>base_link</parent_link>
      <child_model>tennis_ball_1</child_model>
      <child_link>ball_1_link</child_link>
      <detach_topic>/ball_1/detach</detach_topic>
      <attach_topic>/ball_1/attach</attach_topic>
      <output_topic>/ball_1/state</output_topic>
    </plugin>
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>base_link</parent_link>
      <child_model>tennis_ball_2</child_model>
      <child_link>ball_2_link</child_link>
      <detach_topic>/ball_2/detach</detach_topic>
      <attach_topic>/ball_2/attach</attach_topic>
      <output_topic>/ball_2/state</output_topic>
    </plugin>
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>base_link</parent_link>
      <child_model>tennis_ball_3</child_model>
      <child_link>ball_3_link</child_link>
      <detach_topic>/ball_3/detach</detach_topic>
