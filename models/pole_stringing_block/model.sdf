<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="pole_stringing_block">

    <static>false</static>


    <!-- ================================================== -->
    <!-- POLE + FIXED FRAME -->
    <!-- ================================================== -->

    <link name="pole_link">

      <inertial>
        <mass>20.0</mass>

        <inertia>
          <ixx>1.0</ixx>
          <iyy>1.0</iyy>
          <izz>1.0</izz>

          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>


      <visual name="pole_visual">

        <geometry>
          <mesh>
            <uri>model://pole_stringing_block/meshes/Pole.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>

        <material>
          <ambient>0.45 0.45 0.45 1</ambient>
          <diffuse>0.55 0.55 0.55 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>

      </visual>

    </link>


    <!-- ================================================== -->
    <!-- PULLEY -->
    <!-- ================================================== -->

    <link name="pulley_link">

      <!-- Origin = pulley rotation axis -->
      <pose>
        0.302080
        2.480532
        0.394658
        0 0 0
      </pose>


      <inertial>

        <pose>
          0.000020
          0.000028
          0.000000
          0 0 0
        </pose>

        <mass>0.20</mass>

        <inertia>
          <ixx>0.00022237</ixx>
          <iyy>0.00022237</iyy>
          <izz>0.00022408</izz>

          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>

      </inertial>


      <visual name="pulley_visual">

        <pose>
          -0.091969
          -2.426755
          -0.076717
          0 0 0
        </pose>

        <geometry>
          <mesh>
            <uri>model://pole_stringing_block/meshes/Pulley.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>

        <material>
          <ambient>0.80 0.05 0.05 1</ambient>
          <diffuse>0.90 0.08 0.08 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
        </material>

      </visual>


      <collision name="pulley_collision">

        <pose>
          -0.091969
          -2.426755
          -0.076717
          0 0 0
        </pose>

        <geometry>
          <mesh>
            <uri>model://pole_stringing_block/meshes/Pulley.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>0.4</mu>
              <mu2>0.4</mu2>
            </ode>
          </friction>
        </surface>

      </collision>

    </link>


    <!-- ================================================== -->
    <!-- LATCH -->
    <!-- ================================================== -->

    <link name="latch_link">

      <!-- Origin = latch hinge -->
      <pose>
        0.302080
        2.625026
        0.442658
        0 0 0
      </pose>


      <inertial>

        <!--
          COM approximately 31.6 mm below hinge.
          Therefore gravity naturally returns latch to q = 0.
        -->
        <pose>
          -0.000094
          -0.031573
           0.000154
          0 0 0
        </pose>

        <mass>0.05</mass>

        <inertia>

          <ixx>0.000033918</ixx>
          <iyy>0.000002196</iyy>
          <izz>0.000032940</izz>

          <ixy>0.000000153</ixy>
          <ixz>0.000000000</ixz>
          <iyz>0.000000144</iyz>

        </inertia>

      </inertial>


      <visual name="latch_visual">

        <pose>
          -0.091989
          -2.570283
          -0.123715
          0 0 0
        </pose>

        <geometry>
          <mesh>
            <uri>model://pole_stringing_block/meshes/Latch.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>

        <material>
          <ambient>0.05 0.65 0.05 1</ambient>
          <diffuse>0.08 0.85 0.08 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
        </material>

      </visual>


      <collision name="latch_collision">

        <pose>
          -0.091989
          -2.570283
          -0.123715
          0 0 0
        </pose>

        <geometry>
          <mesh>
            <uri>model://pole_stringing_block/meshes/Latch.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>0.3</mu>
              <mu2>0.3</mu2>
            </ode>
          </friction>
        </surface>

      </collision>

    </link>


    <!-- ================================================== -->
    <!-- FIX POLE TO WORLD -->
    <!-- ================================================== -->

    <joint name="pole_world_joint" type="fixed">

      <parent>world</parent>
      <child>pole_link</child>

    </joint>


    <!-- ================================================== -->
    <!-- PULLEY REVOLUTE JOINT -->
    <!-- ================================================== -->

    <joint name="pulley_joint" type="revolute">

      <parent>pole_link</parent>
      <child>pulley_link</child>

      <pose relative_to="pole_link">
        0.302080
        2.480532
        0.394658
        0 0 0
      </pose>


      <axis>

        <xyz>0 0 1</xyz>

        <dynamics>

          <!-- Very low bearing resistance -->
          <damping>0.0005</damping>

          <friction>0.00005</friction>

        </dynamics>

      </axis>

    </joint>


    <!-- ================================================== -->
    <!-- LATCH REVOLUTE JOINT -->
    <!-- ================================================== -->

    <joint name="latch_joint" type="revolute">

      <parent>pole_link</parent>
      <child>latch_link</child>

      <pose relative_to="pole_link">
        0.302080
        2.625026
        0.442658
        0 0 0
      </pose>


      <axis>

        <xyz>1 0 0</xyz>


        <!--
          q = 0 rad   : closed
          q = 0.8 rad : fully opened

          Negative direction is blocked.
        -->
        <limit>

          <lower>0.0</lower>

          <upper>0.8</upper>

        </limit>


        <!--
          No spring.
          Gravity provides the restoring torque.
        -->
        <dynamics>

          <!-- Just enough damping to prevent oscillation -->
          <damping>0.0005</damping>

          <!-- Almost frictionless hinge -->
          <friction>0.0</friction>

        </dynamics>

      </axis>

    </joint>


    <!-- ================================================== -->
    <!-- JOINT STATE PUBLISHER -->
    <!-- ================================================== -->

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">

      <joint_name>pulley_joint</joint_name>

      <joint_name>latch_joint</joint_name>

    </plugin>


  </model>

</sdf>